{
  "name": "nox-helion-super-cinema-3d",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Optional local 3D visual renderer and shared AI generation asset contract for NOX",
  "scripts": {
    "build": "esbuild src/scene3d.mjs --bundle --format=iife --global-name=NOXSuperCinema3D --minify --outfile=dist/nox-cinema3d.js",
    "test": "node --test tests/generation.test.mjs tests/scene3d.test.mjs",
    "check": "node --check src/generation.mjs && node --check src/scene3d.mjs"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
