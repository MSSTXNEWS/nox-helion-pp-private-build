+                'current_bytes', 'max_bytes', 'inactive_file_bytes', 'file_bytes',
+                'shmem_bytes', 'sandbox_limit_bytes', 'planner_reserve_bytes',
+                'minimum_headroom_bytes', 'memory_psi_some_avg10',
+                'memory_psi_full_avg10', 'cpu_pressure'}
