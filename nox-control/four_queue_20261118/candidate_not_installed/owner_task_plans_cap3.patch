+def global_worker_cap():
+    """Explicit owner cap; legacy capacity remains six when no cap was set.
+
+    A cap is an admission limit, not a claim about live OS processes. Invalid
+    explicit policy cannot silently restore the legacy six-slot allowance.
+    """
+    try:
+        config = read_json(ROOT / 'config/owner_task_lifecycle.json', 16000)
+    except FileNotFoundError:
+        return 6
+    except (OSError, ValueError, PlanHold) as exc:
+        raise PlanHold('HOLD_GLOBAL_WORKER_CAP_UNREADABLE') from exc
+    if not isinstance(config, dict):
+        raise PlanHold('HOLD_GLOBAL_WORKER_CAP_SCHEMA')
+    policy = config.get('parallelism', {})
+    if not isinstance(policy, dict):
+        raise PlanHold('HOLD_GLOBAL_WORKER_CAP_SCHEMA')
+    if 'global_cap' not in policy:
+        return 6
+    cap = policy['global_cap']
+    if (config.get('schema') != 'NOX_OWNER_TASK_LIFECYCLE_V1'
+            or type(cap) is not int or not 3 <= cap <= 6):
+        raise PlanHold('HOLD_GLOBAL_WORKER_CAP_SCHEMA')
+    return cap
+
+
+def requested_worker_target(request):
+    cap = global_worker_cap()
+    target = request.get('worker_target', cap)
+    if type(target) is not int or not 3 <= target <= cap:
+        raise PlanHold('NEEDS_PLAN_WORKER_TARGET_WITHIN_OWNER_CAP')
+    return target
+
