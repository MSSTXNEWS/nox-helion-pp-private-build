"""Durable request/event ledger inside the ORIGINAL S03 SQLite connection.

No second database, model or service. One request may start inference once;
reconnect replays persisted events. A dead producer is interrupted, not retried.
"""
from __future__ import annotations
from datetime import datetime, timezone
import hashlib
import json
import os
from pathlib import Path
import re
import sqlite3
import time
import uuid

REQUEST_ID=re.compile(r'^[A-Za-z0-9_.:-]{1,128}$')
TERMINAL=frozenset(('done','error','interrupted'))
SCHEMA='''
CREATE TABLE IF NOT EXISTS nox_chat_requests (
 owner TEXT NOT NULL, request_id TEXT NOT NULL, payload_sha256 TEXT NOT NULL,
 dialog_id TEXT, exchange_id TEXT NOT NULL, question TEXT NOT NULL,
 state TEXT NOT NULL, answer TEXT NOT NULL DEFAULT '', last_event_id INTEGER NOT NULL DEFAULT 0,
 session_scope TEXT NOT NULL, producer_token TEXT NOT NULL, producer_pid INTEGER NOT NULL,
 producer_ticks INTEGER NOT NULL, producer_boot TEXT NOT NULL,
 stop_requested INTEGER NOT NULL DEFAULT 0, saved INTEGER NOT NULL DEFAULT 0,
 s03_record_id TEXT, s03_sha256 TEXT, error TEXT,
 created_at REAL NOT NULL, updated_at REAL NOT NULL,
 PRIMARY KEY(owner,request_id)
);
CREATE TABLE IF NOT EXISTS nox_chat_events (
 owner TEXT NOT NULL, request_id TEXT NOT NULL, event_id INTEGER NOT NULL,
 payload TEXT NOT NULL, created_at REAL NOT NULL,
 PRIMARY KEY(owner,request_id,event_id),
 FOREIGN KEY(owner,request_id) REFERENCES nox_chat_requests(owner,request_id)
);
CREATE INDEX IF NOT EXISTS nox_chat_active_owner ON nox_chat_requests(owner,state,session_scope);
'''


class LedgerError(ValueError):
    def __init__(self,code,status=409):
        super().__init__(code);self.code=code;self.status=status


def identity(pid=None):
    pid=os.getpid() if pid is None else pid
    try:
        fields=Path('/proc',str(pid),'stat').read_text().rsplit(') ',1)[1].split()
        # A PID can remain present in /proc while its producer is stopped,
        # traced, zombie, or dead. Such a PID cannot prove live SSE progress.
        if len(fields)<20 or fields[0] not in {'R','S','D','I'}:return None
        ticks=int(fields[19])
        if ticks<=0:return None
        return (pid,ticks,Path('/proc/sys/kernel/random/boot_id').read_text().strip())
    except (OSError,ValueError,IndexError):return None


def request_id(value):
    if not isinstance(value,str) or not REQUEST_ID.fullmatch(value):raise LedgerError('INVALID_REQUEST_ID',422)
    return value


def fingerprint(value):
    return hashlib.sha256(json.dumps(value,ensure_ascii=False,sort_keys=True,separators=(',',':'),allow_nan=False).encode()).hexdigest()


class RequestLedger:
    def __init__(self,db,owner):self.db=db;self.owner=owner

    def ready(self):
        try:
            with self.db() as db:
                names={r[0] for r in db.execute("SELECT name FROM sqlite_master WHERE type='table'")}
            return {'s03_items','nox_chat_requests','nox_chat_events'}<=names
        except (OSError,sqlite3.Error,RuntimeError):return False

    def _get(self,db,rid):
        row=db.execute('SELECT * FROM nox_chat_requests WHERE owner=? AND request_id=?',(self.owner,rid)).fetchone()
        if row is None:raise LedgerError('CHAT_REQUEST_NOT_FOUND',404)
        return dict(row)

    def _public(self,row):
        return {'schema':'NOX_CHAT_REQUEST_V1','request_id':row['request_id'],'dialog_id':row['dialog_id'],
            'conversation_id':row['dialog_id'],'exchange_id':row['exchange_id'],'message':row['question'],
            'state':row['state'],'last_event_id':row['last_event_id'],'answer':row['answer'],
            'terminal':row['state'] in TERMINAL,'saved':bool(row['saved']),
            's03_integrated':bool(row['saved']),'s03_record_id':row['s03_record_id'],
            's03_sha256':row['s03_sha256'],'error':row['error'],'stop_requested':bool(row['stop_requested'])}

    def _append(self,db,row,event):
        number=row['last_event_id']+1
        obj={**event,'request_id':row['request_id'],'dialog_id':row['dialog_id'],
             'conversation_id':row['dialog_id'],'exchange_id':row['exchange_id'],'event_id':number}
        raw=json.dumps(obj,ensure_ascii=False,separators=(',',':'),allow_nan=False)
        db.execute('INSERT INTO nox_chat_events(owner,request_id,event_id,payload,created_at) VALUES(?,?,?,?,?)',
                   (self.owner,row['request_id'],number,raw,time.time()))
        db.execute('UPDATE nox_chat_requests SET last_event_id=?,updated_at=? WHERE owner=? AND request_id=?',
                   (number,time.time(),self.owner,row['request_id']))
        row['last_event_id']=number
        return obj

    def _recover(self,db,row):
        if row['state'] in TERMINAL:return row
        if identity(row['producer_pid'])==(row['producer_pid'],row['producer_ticks'],row['producer_boot']):return row
        self._append(db,row,{'type':'error','error':'STREAM_INTERRUPTED_RESTART','gpu_stop_verified':False})
        db.execute("UPDATE nox_chat_requests SET state='interrupted',error=? WHERE owner=? AND request_id=?",
                   ('STREAM_INTERRUPTED_RESTART',self.owner,row['request_id']))
        return self._get(db,row['request_id'])

    def accept(self,rid,question,dialog_id,payload,session_scope,*,after_event_id=0):
        if type(after_event_id) is not int or not 0 <= after_event_id <= 2**63-1:
            raise LedgerError('INVALID_EVENT_CURSOR',422)
        rid=request_id(rid);wanted=fingerprint(payload);native=identity()
        if native is None:raise LedgerError('HOLD_PRODUCER_PROCESS_IDENTITY',503)
        with self.db(True) as db:
            db.execute('BEGIN IMMEDIATE')
            old=db.execute('SELECT * FROM nox_chat_requests WHERE owner=? AND request_id=?',(self.owner,rid)).fetchone()
            if old is not None:
                prior=dict(old)
                # A request ID is scoped to its ORIGINAL session and exchange.
                # A matching payload hash alone must not replay another tab's
                # owner session, dialog, or question. Check before _recover:
                # a cross-scope collision must not mutate the original row.
                if (prior['session_scope']!=session_scope or
                        prior['dialog_id']!=dialog_id or prior['question']!=question):
                    raise LedgerError('REQUEST_ID_CONTEXT_CONFLICT')
                if prior['payload_sha256']!=wanted:
                    raise LedgerError('REQUEST_ID_PAYLOAD_CONFLICT')
                # Reject reconnects ahead of the original committed cursor
                # before recovery can append an event or modify this request.
                if after_event_id>prior['last_event_id']:
                    raise LedgerError('EVENT_CURSOR_AHEAD')
                row=self._recover(db,prior)
                return self._public(row),None
            # A new request has no committed events. Cursor admission belongs
            # to this same transaction, before insertion or producer startup.
            if after_event_id:
                raise LedgerError('EVENT_CURSOR_AHEAD')
            others=db.execute("SELECT * FROM nox_chat_requests WHERE owner=? AND state IN ('accepted','running') AND (session_scope=? OR (dialog_id IS NOT NULL AND dialog_id=?))",
                              (self.owner,session_scope,dialog_id)).fetchall()
            for other in others:
                if self._recover(db,dict(other))['state'] not in TERMINAL:
                    raise LedgerError('HOLD_ACTIVE_SESSION_STREAM')
            token=uuid.uuid4().hex;stamp=time.time()
            db.execute('INSERT INTO nox_chat_requests(owner,request_id,payload_sha256,dialog_id,exchange_id,question,state,session_scope,producer_token,producer_pid,producer_ticks,producer_boot,created_at,updated_at) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?)',
                (self.owner,rid,wanted,dialog_id,uuid.uuid4().hex,question,'accepted',session_scope,token,*native,stamp,stamp))
            row=self._get(db,rid)
            self._append(db,row,{'type':'preparing','stream_mode':'NATIVE_TOKEN_STREAM'})
            return self._public(self._get(db,rid)),token

    def snapshot(self,rid):
        with self.db(True) as db:
            db.execute('BEGIN IMMEDIATE')
            return self._public(self._recover(db,self._get(db,request_id(rid))))

    def events(self,rid,after,limit=256):
        if type(after) is not int or not 0 <= after <= 2**63-1:
            # sqlite3 binds INTEGER parameters as signed 64-bit values.
            # A huge Python int otherwise raises OverflowError (HTTP 500).
            raise LedgerError('INVALID_EVENT_CURSOR',422)
        # SQLite LIMIT -1 disables the page bound. Never allow a malformed
        # reconnect caller to read the entire durable SSE event history.
        if type(limit) is not int or not 1 <= limit <= 256:
            raise LedgerError('INVALID_EVENT_PAGE_LIMIT',422)
        rid=request_id(rid)
        # Snapshot and event page must refer to the SAME SQLite commit.  A
        # producer may otherwise append after snapshot() and before SELECT,
        # giving the browser event_id > snapshot.last_event_id on reconnect.
        # Keep _recover inside this short writer transaction: it may insert
        # the terminal STREAM_INTERRUPTED_RESTART event.
        with self.db(True) as db:
            db.execute('BEGIN IMMEDIATE')
            snapshot=self._public(self._recover(db,self._get(db,rid)))
            if after>snapshot['last_event_id']:raise LedgerError('EVENT_CURSOR_AHEAD')
            rows=db.execute('SELECT payload FROM nox_chat_events WHERE owner=? AND request_id=? AND event_id>? ORDER BY event_id LIMIT ?',
                            (self.owner,rid,after,limit)).fetchall()
            return [json.loads(row[0]) for row in rows],snapshot

    def append(self,rid,token,event):
        kind=event.get('type')
        if kind not in ('start','delta','error'):raise LedgerError('INVALID_LEDGER_EVENT',422)
        with self.db(True) as db:
            db.execute('BEGIN IMMEDIATE');row=self._get(db,rid)
            if row['producer_token']!=token or row['state'] in TERMINAL:raise LedgerError('HOLD_REQUEST_PRODUCER_FENCE')
            # STOP and start/delta share this BEGIN IMMEDIATE transaction. A queued
            # upstream chunk must not become a persisted token after owner STOP.
            # Keep error append available so the request can become terminal.
            if row['stop_requested'] and kind in ('start','delta'):
                raise LedgerError('STREAM_STOP_REQUESTED')
            if kind=='delta':
                part=event.get('text')
                if not isinstance(part,str) or len(row['answer'])+len(part)>2000000:raise LedgerError('HOLD_OUTPUT_SIZE')
                db.execute("UPDATE nox_chat_requests SET answer=answer||? WHERE owner=? AND request_id=?",(part,self.owner,rid))
            if kind=='start':db.execute("UPDATE nox_chat_requests SET state='running' WHERE owner=? AND request_id=?",(self.owner,rid))
            if kind=='error':
                error=event.get('error','HOLD_EXISTING_ONEHOST_RUNTIME')
                db.execute("UPDATE nox_chat_requests SET state='error',error=? WHERE owner=? AND request_id=?",(error,self.owner,rid))
                event={**event,'gpu_stop_verified':False}
            return self._append(db,row,event)

    def complete(self,rid,token,proof):
        with self.db(True) as db:
            db.execute('BEGIN IMMEDIATE');row=self._get(db,rid)
            if row['producer_token']!=token or row['state'] in TERMINAL:raise LedgerError('HOLD_REQUEST_PRODUCER_FENCE')
            if row['stop_requested']:raise LedgerError('STREAM_STOP_REQUESTED')
            if not row['answer'].strip() or not isinstance(proof,dict) or not isinstance(proof.get('record_id'),str) or not re.fullmatch('[a-fA-F0-9]{64}',str(proof.get('sha256',''))):
                raise LedgerError('HOLD_S03_COMMIT_NOT_VERIFIED')
            # Verify the precise referenced row remains in the ORIGINAL S03.
            original=db.execute('SELECT sha256 FROM s03_items WHERE id=?',(proof['record_id'],)).fetchone()
            if original is None or original[0]!=proof['sha256']:raise LedgerError('HOLD_S03_COMMIT_NOT_VERIFIED')
            stamp=datetime.now(timezone.utc).isoformat(timespec='milliseconds')
            if row['dialog_id']:
                dialog=db.execute('SELECT archived FROM nox_v29_dialogs WHERE owner=? AND dialog_id=?',(self.owner,row['dialog_id'])).fetchone()
                if dialog is None or dialog[0]:raise LedgerError('HOLD_S03_DIALOG_COMMIT_NOT_VERIFIED')
                expected={'user':row['question'],'assistant':row['answer']}
                seen=db.execute('SELECT role,content FROM nox_v29_dialog_messages WHERE dialog_id=? AND exchange_id=?',(row['dialog_id'],row['exchange_id'])).fetchall()
                if seen and (len(seen)!=2 or {r[0]:r[1] for r in seen}!=expected):raise LedgerError('HOLD_DIALOG_RECEIPT_COLLISION')
                if not seen:
                    for role,content in expected.items():
                        db.execute('INSERT INTO nox_v29_dialog_messages(dialog_id,exchange_id,role,content,ts) VALUES(?,?,?,?,?)',
                                   (row['dialog_id'],row['exchange_id'],role,content,stamp))
                    db.execute('UPDATE nox_v29_dialogs SET updated_at=?,revision=revision+1 WHERE owner=? AND dialog_id=?',(stamp,self.owner,row['dialog_id']))
            db.execute("UPDATE nox_chat_requests SET state='done',saved=1,s03_record_id=?,s03_sha256=? WHERE owner=? AND request_id=?",
                       (proof['record_id'],proof['sha256'],self.owner,rid))
            return self._append(db,row,{'type':'done','model':'NOX HELION','saved':True,'s03_integrated':True,
                's03_record_id':proof['record_id'],'s03_sha256':proof['sha256'],'stream_mode':'NATIVE_TOKEN_STREAM'})

    def stop(self,rid):
        with self.db(True) as db:
            db.execute('BEGIN IMMEDIATE');row=self._get(db,request_id(rid))
            if row['state'] in TERMINAL:raise LedgerError('NO_ACTIVE_REQUEST_STREAM')
            db.execute('UPDATE nox_chat_requests SET stop_requested=1 WHERE owner=? AND request_id=?',(self.owner,rid))
        return {'status':'STOP_REQUESTED','request_id':rid,'stop_recorded':True,'stream_cancellation_signalled':False,'gpu_stop_verified':False}
