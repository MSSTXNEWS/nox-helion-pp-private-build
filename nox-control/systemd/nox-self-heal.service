[Unit]
Description=NOX bounded self-heal guard (not a second scheduler)
After=network.target
StartLimitIntervalSec=3600
StartLimitBurst=6

[Service]
Type=simple
User=root
ExecStart=/usr/bin/python3 /opt/nox/nox-control/nox_self_heal.py --policy /etc/nox/repair-policy.json --state /var/lib/nox/repair-state.json
Restart=always
RestartSec=10
TimeoutStopSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/nox
ProtectHome=true

[Install]
WantedBy=multi-user.target
