"""Read a fenced durable exchange from the single existing S03 connection."""
from collections.abc import Mapping
from contextlib import AbstractContextManager
import re
from typing import Callable


_DIALOG = re.compile(r'[a-f0-9]{32}\Z')
_OWNER = 'nox-single-owner'


def read_existing_exchange(
    connect: Callable[[], AbstractContextManager],
    locate_durable: Callable[[str, str, str, str], Mapping],
    permit: Callable[[], bool],
    *,
    dialog_id: str,
    turn_id: str,
    receipt_id: str,
    lease_epoch: str,
) -> dict | None:
    """Map a native writer receipt, then read the existing owner-only V112 pair.

    locate_durable is the authoritative receipt lookup from the native writer,
    not inferred from text or from a browser-supplied exchange ID. connect is
    the existing V112 read-only S03 context. This module issues only SELECT.
    """
    if permit() is not True or not _DIALOG.fullmatch(dialog_id):
        return None
    record = locate_durable(dialog_id, turn_id, receipt_id, lease_epoch)
    if (
        not isinstance(record, Mapping)
        or record.get('durable') is not True
        or record.get('verified') is not True
        or record.get('dialog_id') != dialog_id
        or record.get('turn_id') != turn_id
        or record.get('receipt_id') != receipt_id
        or record.get('lease_epoch') != lease_epoch
    ):
        return None
    exchange_id = record.get('exchange_id')
    if not isinstance(exchange_id, str) or not 6 <= len(exchange_id) <= 160 or permit() is not True:
        return None
    with connect() as db:
        # Opening the existing connection can cross an owner revocation.
        # Recheck before starting SQL, not only after exposing its result.
        if permit() is not True:
            return None
        result = db.execute(
            'SELECT m.role,m.content,m.exchange_id FROM nox_v29_dialog_messages m '
            'JOIN nox_v29_dialogs d ON d.dialog_id=m.dialog_id '
            'WHERE d.owner=? AND d.archived=0 AND d.dialog_id=? AND m.exchange_id=? '
            'ORDER BY m.row_id LIMIT 3',
            (_OWNER, dialog_id, exchange_id),
        ).fetchall()
    if (
        len(result) != 2 or permit() is not True
        or any(
            role != ('user', 'assistant')[index]
            or not isinstance(content, str) or not content.strip()
            or row_exchange != exchange_id
            for index, (role, content, row_exchange) in enumerate(result)
        )
    ):
        return None
    return {
        'status': 'READY', 'dialog_id': dialog_id, 'turn_id': turn_id,
        'receipt_id': receipt_id, 'exchange_id': exchange_id,
        'messages': [{'role': role, 'content': content, 'exchange_id': row_exchange}
                     for role, content, row_exchange in result],
    }
