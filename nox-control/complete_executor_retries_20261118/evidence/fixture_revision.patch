 import work_progress as progress
+
+
+def _open_file_descriptor_count():
+    """Count real descriptors without requiring a mounted proc filesystem."""
+    limit = resource.getrlimit(resource.RLIMIT_NOFILE)[0]
+    if limit == resource.RLIM_INFINITY or limit < 0:
+        raise RuntimeError('FINITE_NOFILE_LIMIT_REQUIRED_FOR_FD_LEAK_CHECK')
+    count = 0
+    for descriptor in range(limit):
+        try:
+            fcntl.fcntl(descriptor, fcntl.F_GETFD)
+        except OSError as error:
+            if error.errno != errno.EBADF:
+                raise
+        else:
+            count += 1
+    return count
 
 
