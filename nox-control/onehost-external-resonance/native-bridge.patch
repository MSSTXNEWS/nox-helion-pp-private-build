+async def _read_completed_turn(dialog_id, request_id, question, answer, started,
+                               *, legacy_prefix=False, stop_requested=None):
+    if stop_requested is not None and stop_requested():
+        return None
+    if dialog_id:
+        from nox_s03_scoped_pair import commit_scoped_pair
+        return await asyncio.to_thread(
+            commit_scoped_pair, _db, _now, dialog_id, request_id, question, answer, stop_requested)
+    # No-dialog NDJSON preserves the existing strict-first, prefix-second read.
+    for attempt in range(4):
+        if stop_requested is not None and stop_requested():
+            return None
+        proof = await asyncio.to_thread(_readback, question, answer, started, True)
+        if proof is not None:
+            return {**proof, 'proof': 'M1_LENGTH_FRAMED_V2_SHA256'}
+        if legacy_prefix and (stop_requested is None or not stop_requested()):
+            proof = await asyncio.to_thread(_readback, question, answer, started)
+            if proof is not None:
+                return {**proof, 'proof': 'LEGACY_SUBSTRING_READBACK'}
+        if attempt < 3:
+            await asyncio.sleep(.12)
+    return None
