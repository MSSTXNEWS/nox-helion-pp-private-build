+
+    def _m23_sync_motion(self, *_ignored) -> None:
+        hud = getattr(self, 'm23_hud', None)
+        if hud is not None and hasattr(self, 's08_reduced_motion'):
+            hud.reduced_motion = bool(self.s08_reduced_motion.get())
+
+    def _m23_refresh_hud(self) -> None:
+        hud = getattr(self, 'm23_hud', None)
+        if hud is not None:
+            try:
+                hud.refresh()
+            except self.tk.TclError:
+                pass
+
+    def _m23_on_scope(self) -> None:
+        gate = getattr(self, 'm23_gate', None)
+        if gate is None:
+            return
+        try:
+            gate.switch_persona(self.persona.get())
+        except ValueError:
+            return
+        hud = getattr(self, 'm23_hud', None)
+        if hud is not None:
+            try:
+                hud.animate_to(self.persona.get())
+            except self.tk.TclError:
+                pass
+
+    def _m23_allow_assistant(self, generation: int) -> bool:
+        gate = getattr(self, 'm23_gate', None)
+        if gate is None:
+            return True
+        try:
+            return gate.allow_assistant_write(self.persona.get(), generation)
+        except ValueError:
+            return False
+
+    def _m23_finish(self, generation: int, response, *, allow_text: bool) -> None:
+        gate = getattr(self, 'm23_gate', None)
+        if gate is None:
+            return
+        persona = self.persona.get()
+        text = response.get('response') if isinstance(response, dict) else None
+        if (allow_text and isinstance(response, dict)
+                and response.get('outcome') == 'DONE'
+                and response.get('real_local_reply') is True
+                and isinstance(text, str) and text.strip()):
+            gate.try_commit_assistant(
+                persona, text[:8000], generation, source='verified_local_reply')
+            return
+        try:
+            gate.settle_without_reply(persona, generation)
+        except ValueError:
+            return
+
+    def m23_physical_stop(self, _event=None):
+        """Button and Alt+S. Latch HALTED before the backend cancel."""
+        gate = getattr(self, 'm23_gate', None)
+        if gate is not None:
+            gate.halt()
+        try:
+            self.stop()
+        finally:
+            try:
+                self.request_button.configure(state='disabled')
+            except self.tk.TclError:
