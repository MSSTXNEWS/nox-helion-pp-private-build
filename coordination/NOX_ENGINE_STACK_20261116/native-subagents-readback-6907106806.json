  "remember_function_source": "def remember(text: str, segment: str = \"M1\", provenance: str = \"chat\",\n             salience: float = 0.5, meta: Optional[dict] = None, db: Path = DB) -> dict:\n    if segment not in SEGMENTS:\n        raise ValueError(f\"bad segment {segment}\")\n    text = (text or \"\").strip()\n    if not text:\n        return {}\n    h = sha(segment + \"|\" + text)\n    con = init_db(db)\n    existing = con.execute(\"SELECT id FROM s03_items WHERE sha256=?\", (h,)).fetchone()\n    if existing:\n        rec = {\"id\": existing[\"id\"], \"sha256\": h, \"dedup\": True}\n        con.close()\n        return rec\n    iid = \"S03-\" + uuid.uuid4().hex[:16]\n    ts = now_iso()\n    con.execute(\n        \"INSERT INTO s03_items(id,segment,text,provenance,sha256,salience,ts,meta) VALUES(?,?,?,?,?,?,?,?)\",\n        (iid, segment, text[:8000], provenance, h, float(salience), ts,\n         json.dumps(meta or {}, ensure_ascii=False)),\n    )\n    try:\n        con.execute(\"INSERT INTO s03_fts(id,text,segment) VALUES(?,?,?)\", (iid, text[:8000], segment))\n    except sqlite3.Error:\n        pass\n    con.commit(); con.close()\n    return {\"id\": iid, \"segment\": segment, \"sha256\": h, \"ts\": ts, \"dedup\": False}",
