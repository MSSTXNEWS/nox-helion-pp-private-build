diff --git a/P03.ModelCenter/ModelArtifactReviewRegistry.cs b/P03.ModelCenter/ModelArtifactReviewRegistry.cs
new file mode 100644
index 0000000..27ef3e5
--- /dev/null
+++ b/P03.ModelCenter/ModelArtifactReviewRegistry.cs
@@ -0,0 +1,117 @@
+using System.Text.Json;
+using System.Text.RegularExpressions;
+
+namespace Nox.P03;
+
+/// <summary>
+/// Evidence is supplied by an authorized reviewer, not synthesized from family pages.
+/// The host must independently authenticate the review receipt and its owner before
+/// calling TryPromote. No network access, weights download, or automatic approval.
+/// </summary>
+public sealed record ModelArtifactReviewCandidate(
+    string FamilyId,
+    string OfficialSourceUrl,
+    string? ExactTag,
+    string? Version,
+    string? LicenseId,
+    string? LicenseEvidenceUrl,
+    long? ArtifactBytes,
+    long? RequiredDiskBytes,
+    long? RecommendedRamBytes,
+    long? RecommendedVramBytes,
+    string? ArtifactSha256,
+    string? ManifestSha256,
+    string? CompatibilityEvidenceUrl,
+    string? ImmutableRevision,
+    bool CompatibilityReviewed,
+    string? ReviewerReceiptId,
+    string ReviewStatus = "REVIEW_REQUIRED");
+
+public static class ModelArtifactReviewRegistry
+{
+    private static readonly Regex TagPattern = new(
+        @"^[a-zA-Z0-9][a-zA-Z0-9._-]*(/[a-zA-Z0-9][a-zA-Z0-9._-]*)?:[a-zA-Z0-9][a-zA-Z0-9._-]*$",
+        RegexOptions.Compiled);
+    private const string OfficialHost = "ollama.com";
+    public const int RequiredSourceCount = 15;
+
+    // A template is intentionally incomplete and cannot enable a download.
+    public static IReadOnlyList<ModelArtifactReviewCandidate> ReadTemplate(string path)
+    {
+        using var stream = File.OpenRead(path);
+        using var json = JsonDocument.Parse(stream);
+        if (!json.RootElement.TryGetProperty("items", out var items) || items.ValueKind != JsonValueKind.Array)
+            throw new InvalidDataException("Model source template has no items array.");
+        if (items.GetArrayLength() < RequiredSourceCount || items.GetArrayLength() > 250)
+            throw new InvalidDataException("Model source count is outside the frozen review range.");
+        var result = new List<ModelArtifactReviewCandidate>();
+        var ids = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
+        foreach (var x in items.EnumerateArray())
+        {
+            var id = x.GetProperty("family").GetString() ?? "";
+            var source = x.GetProperty("officialSourceUrl").GetString() ?? "";
+            if (!ids.Add(id) || !ModelCatalog.OfficialFamilies.Any(f => f.Id.Equals(id, StringComparison.OrdinalIgnoreCase)) ||
+                !IsOfficialUrl(source, id))
+                throw new InvalidDataException("Duplicate, unknown, or non-official model source.");
+            result.Add(new ModelArtifactReviewCandidate(id, source, null, null, null, null,
+                null, null, null, null, null, null, null, null, false, null));
+        }
+        return result;
+    }
+
+    /// <summary>Requires independent host-approved evidence; malformed/unknown fields stay HOLD.</summary>
+    public static bool TryPromote(ModelArtifactReviewCandidate value, bool ownerReceiptVerified,
+        out ModelCatalogEntry? artifact)
+    {
+        artifact = null;
+        if (value is null || !ownerReceiptVerified ||
+            !string.Equals(value.ReviewStatus, "OWNER_VERIFIED", StringComparison.Ordinal) ||
+            string.IsNullOrWhiteSpace(value.ReviewerReceiptId) || value.ReviewerReceiptId.Length > 128 ||
+            !ModelCatalog.OfficialFamilies.Any(f => f.Id.Equals(value.FamilyId, StringComparison.OrdinalIgnoreCase)) ||
+            !IsOfficialUrl(value.OfficialSourceUrl, value.FamilyId) ||
+            !IsHttps(value.LicenseEvidenceUrl, out var licenseUri) ||
+            !IsHttps(value.CompatibilityEvidenceUrl, out var compatibilityUri) ||
+            value.ExactTag is null || value.ExactTag.Length > 160 || !TagPattern.IsMatch(value.ExactTag) ||
+            !value.ExactTag.StartsWith(value.FamilyId + ":", StringComparison.OrdinalIgnoreCase) ||
+            value.ExactTag.EndsWith(":latest", StringComparison.OrdinalIgnoreCase) ||
+            value.ExactTag.Contains("..", StringComparison.Ordinal) ||
+            string.IsNullOrWhiteSpace(value.Version) || string.IsNullOrWhiteSpace(value.LicenseId) ||
+            value.ArtifactBytes is not > 0 || value.RequiredDiskBytes < value.ArtifactBytes ||
+            (value.RecommendedRamBytes is not > 0 && value.RecommendedVramBytes is not > 0) ||
+            !IsDigest(value.ArtifactSha256) || !IsDigest(value.ManifestSha256) ||
+            !IsImmutableRevision(value.ImmutableRevision) || !value.CompatibilityReviewed)
+            return false;
+
+        artifact = ModelCatalog.Get(value.FamilyId) with
+        {
+            EvidenceStatus = CatalogEvidenceStatus.ArtifactVerified,
+            ExactTag = value.ExactTag, Version = value.Version, License = value.LicenseId,
+            ArtifactBytes = value.ArtifactBytes, RequiredDiskBytes = value.RequiredDiskBytes,
+            RecommendedRamBytes = value.RecommendedRamBytes, RecommendedVramBytes = value.RecommendedVramBytes,
+            ExpectedSha256 = value.ArtifactSha256, ExpectedManifestDigestSha256 = value.ManifestSha256,
+            LicenseEvidenceUri = licenseUri, CompatibilityEvidenceUri = compatibilityUri,
+            ImmutableRevision = value.ImmutableRevision, CompatibilityReviewed = true
+        };
+        return artifact.CanOfferOneClickPull;
+    }
+
+    private static bool IsDigest(string? x) => x is { Length: 64 } && x.All(Uri.IsHexDigit);
+    private static bool IsImmutableRevision(string? x) => x is not null &&
+        (x.Length == 40 && x.All(Uri.IsHexDigit) || IsDigest(x) ||
+         x.StartsWith("sha256:", StringComparison.OrdinalIgnoreCase) && IsDigest(x[7..]));
+
+    private static bool IsHttps(string? raw, out Uri? uri)
+    {
+        uri = null;
+        return Uri.TryCreate(raw, UriKind.Absolute, out uri) && uri.Scheme == Uri.UriSchemeHttps &&
+            string.IsNullOrEmpty(uri.UserInfo) && string.IsNullOrEmpty(uri.Fragment);
+    }
+
+    private static bool IsOfficialUrl(string? raw, string family)
+    {
+        if (!IsHttps(raw, out var u) || u is null) return false;
+        return u.Host.Equals(OfficialHost, StringComparison.OrdinalIgnoreCase) &&
+            u.AbsolutePath.Equals("/library/" + family, StringComparison.OrdinalIgnoreCase) &&
+            string.IsNullOrEmpty(u.Query);
+    }
+}
