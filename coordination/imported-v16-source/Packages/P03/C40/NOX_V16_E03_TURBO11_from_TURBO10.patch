diff --git a/P03.ModelCenter/WindowsComponentAdapter.cs b/P03.ModelCenter/WindowsComponentAdapter.cs
index 7ab68f6..1386aa6 100644
--- a/P03.ModelCenter/WindowsComponentAdapter.cs
+++ b/P03.ModelCenter/WindowsComponentAdapter.cs
@@ -31,7 +31,27 @@ public sealed class WindowsComponentAdapter
             return new ComponentStatus(component, false, null, "WinGet requires Windows");
         if (!WingetPackages.TryGetValue(component, out var id))
             throw new ArgumentOutOfRangeException(nameof(component));
-        return await ProbeAsync("winget", new[] { "list", "--id", id, "--exact", "--source", "winget" }, ct);
+        var listing = await ProbeAsync("winget", new[] { "list", "--id", id, "--exact" }, ct);
+        // winget can exit 0 even when no installed package matched. Never
+        // interpret a successful invocation as installed software.
+        var installed = listing.Available && IsExactPackageInList(listing.Version, id);
+        return new ComponentStatus(component, installed, installed ? listing.Version : null,
+            installed ? null : listing.Error ?? "PACKAGE_NOT_FOUND_OR_UNVERIFIED");
+    }
+
+    public static bool IsExactPackageInList(string? output, string expectedPackageId)
+    {
+        if (string.IsNullOrWhiteSpace(output) || string.IsNullOrWhiteSpace(expectedPackageId)) return false;
+        // Exact token match avoids false positives such as Git.Github instead of Git.Git.
+        // A verified table row has a name, two-space column separator, exact
+        // package ID, another separator, then a nonempty version. Do not match
+        // error/help text that merely repeats the queried package ID.
+        var row = @"^\s*\S.*?\s{2,}" + System.Text.RegularExpressions.Regex.Escape(expectedPackageId) +
+            @"\s{2,}\S";
+        foreach (var line in output.Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries))
+            if (System.Text.RegularExpressions.Regex.IsMatch(line, row,
+                System.Text.RegularExpressions.RegexOptions.IgnoreCase)) return true;
+        return false;
     }
 
     public async Task InstallWithWingetAsync(string component, bool explicitlyConfirmed, CancellationToken ct = default)
diff --git a/P03.ModelCenter/WindowsHardwareFacts.cs b/P03.ModelCenter/WindowsHardwareFacts.cs
new file mode 100644
index 0000000..b374e85
--- /dev/null
+++ b/P03.ModelCenter/WindowsHardwareFacts.cs
@@ -0,0 +1,70 @@
+using System.Runtime.InteropServices;
+
+namespace Nox.P03;
+
+/// <summary>Read-only Windows OS memory/disk snapshot, without a new dependency.
+/// GPU VRAM/CUDA readiness must come from the existing signed host sensor and
+/// never be fabricated from CPU/RAM data.</summary>
+public sealed record WindowsHardwareFacts(
+    ulong? RamTotalBytes,
+    ulong? RamFreeBytes,
+    long? SystemDiskFreeBytes,
+    int LogicalCpuCount,
+    string? Diagnostic);
+
+public static class WindowsHardwareReadiness
+{
+    [StructLayout(LayoutKind.Sequential)]
+    private struct MemoryStatusEx
+    {
+        public uint Length;
+        public uint MemoryLoadPercent;
+        public ulong TotalPhysical;
+        public ulong AvailablePhysical;
+        public ulong TotalPage;
+        public ulong AvailablePage;
+        public ulong TotalVirtual;
+        public ulong AvailableVirtual;
+        public ulong AvailableExtendedVirtual;
+    }
+
+    [DllImport("kernel32.dll", EntryPoint = "GlobalMemoryStatusEx", SetLastError = true)]
+    [return: MarshalAs(UnmanagedType.Bool)]
+    private static extern bool GetMemoryStatus(ref MemoryStatusEx status);
+
+    public static WindowsHardwareFacts Capture()
+    {
+        if (!OperatingSystem.IsWindows())
+            return new(null, null, null, Environment.ProcessorCount, "WINDOWS_HARDWARE_NOT_AVAILABLE");
+        ulong? total = null, available = null;
+        long? diskFree = null;
+        var errors = new List<string>();
+        try
+        {
+            var status = new MemoryStatusEx { Length = (uint)Marshal.SizeOf<MemoryStatusEx>() };
+            if (GetMemoryStatus(ref status) && status.TotalPhysical > 0)
+            {
+                total = status.TotalPhysical;
+                available = status.AvailablePhysical;
+            }
+            else errors.Add("WINDOWS_RAM_SENSOR_FAILED");
+        }
+        catch (Exception ex) when (ex is DllNotFoundException or EntryPointNotFoundException or System.ComponentModel.Win32Exception)
+        { errors.Add("WINDOWS_RAM_SENSOR_UNAVAILABLE"); }
+        try
+        {
+            var root = Path.GetPathRoot(Environment.SystemDirectory);
+            if (!string.IsNullOrWhiteSpace(root))
+            {
+                var drive = new DriveInfo(root);
+                if (drive.IsReady) diskFree = drive.AvailableFreeSpace;
+                else errors.Add("SYSTEM_DISK_NOT_READY");
+            }
+            else errors.Add("SYSTEM_DISK_UNKNOWN");
+        }
+        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or ArgumentException)
+        { errors.Add("SYSTEM_DISK_UNAVAILABLE"); }
+        return new(total, available, diskFree, Environment.ProcessorCount,
+            errors.Count > 0 ? string.Join(";", errors) : null);
+    }
+}
