{
  "schema": "nox-teacher-mycelium-policy-v1",
  "revision": "2026-11-12",
  "instructions_version": "0.0.6",
  "architecture": {
    "one_identity": "ONE_NOX_ONE_CHAT",
    "student": "KEEP_EXISTING_NOX_STUDENT_WEIGHTS_UNCHANGED_UNTIL_VERIFIED_TRAINING",
    "teacher_process": "TEACHERS_ARE_FROZEN_ON_SEPARATE_VM_OR_CLI",
    "data_transfer": "TEACHER_GENERATED_TEXT_AND_CRITIQUES_ONLY",
    "mycelium": "ADAPTER_BANKS_ATTACH_TO_NOX_OWN_LAYERS; NEVER_INJECT_INTO_TEACHER_WEIGHTS",
    "persona": "SPIDER_VAMPIRE_IS_EVOLVABLE_ORIGIN_ARCHETYPE_NOT_FIXED_ROLE",
    "convergence": "NOX_GENERATES_THE_USER_VISIBLE_ANSWER_ITSELF",
    "simulation_claims": "NEVER_CLAIM_WEIGHT_ABSORPTION_UNLESS_REAL_NOX_OPTIMIZER_STEPS"
  },
  "modes": {
    "fast_chat": {
      "order": [
        "NOX_RESPONDS_IMMEDIATELY",
        "OPTIONAL_BACKGROUND_TEACHER_REVIEW",
        "SOURCE_LABELLED_ALTERNATE_NOX_REFINEMENT_ON_REQUEST"
      ],
      "background_fanout_max": 1,
      "initial_fanout": 0,
      "automatic_chat_replacement": false,
      "target": "Minimize first token latency; no wait on external teachers."
    },
    "deliberate_comparison": {
      "teacher_count_max": 5,
      "parallel_vms_max": 5,
      "default_parallel_vms": 1,
      "evaluation": [
        "teacher_provenance",
        "objective_task_tests",
        "disagreement_detection",
        "nox_synthesis"
      ],
      "no_vendor_model_picker_in_ui": true,
      "teacher_count_default": 1,
      "second_teacher_condition": "Independent family or proven disagreement on a missing skill; requires opt-in and available GPU"
    },
    "night_distillation": {
      "schedule": "OWNER_CONFIGURED_EXISTING_NOX_TASK_DISPATCHER_ONLY",
      "training_inputs": "APPROVED_RESPONSE_ONLY_PAIRS",
      "teacher_count_max": 5,
      "one_noX_student_optimizer": true,
      "candidate_gates": [
        "DEDUP",
        "PERMISSIONS_AND_PRIVACY",
        "SOURCE_AND_LICENSE",
        "FACT_CHECK_WHERE_POSSIBLE",
        "HOLDOUT_SEPARATION",
        "QUALITY_COMPARISON"
      ],
      "weight_update": "REAL_ADAPTER_GRADIENT_UPDATE_WITH_VERIFIED_CHECKPOINT",
      "targeted_layers": [
        "ATTENTION_PROJECTIONS",
        "GATED_DELTANET",
        "SHARED_EXPERT",
        "SELECTED_ROUTED_EXPERTS_AFTER_COMPATIBILITY_TEST"
      ],
      "methods_to_trial": [
        "BF16_LORA",
        "RS_LORA",
        "DORA_IF_SUPPORTED",
        "RESPONSE_ONLY_SFT",
        "DPO_AFTER_PREFERENCE_LABELS"
      ],
      "no_force_switch_training_running": true,
      "independent_snapshot_transfer": true,
      "teacher_count_default": 1,
      "training_selection": "Only novel approved samples for independently measured gaps; no perpetual blind sampling"
    }
  },
  "isolation": {
    "no_paid_provider_required": true,
    "offline_cli_backends": [
      "llama_cpp_cli",
      "ollama_cli"
    ],
    "in_process_offline_candidate": "transformers+PEFT local_files_only; require trainer/VM resource isolation",
    "local_protocol_optional": "OPENAI_COMPAT_LOOPBACK_IS_NOT_PAID_CLOUD_API",
    "hosted_fallbacks_disabled_by_default": true,
    "no_external_private_chat_prompt": true,
    "no_public_teacher_port": true,
    "no_public_root_shell": true,
    "max_vm_workers_subject_to_available_gpu": true
  },
  "learning": {
    "accepted_output_source": "VERIFIED_TEACHER_RESPONSE_ONLY",
    "original_teacher_weights_preserved": true,
    "no_teacher_base_weight_merge": true,
    "provenance_required": true,
    "s03": "SINGLE_EXISTING_S03_WITH_TEMPORAL_MEMORY_AND_SKILL_HISTORY",
    "real_optimizer_receipt_required": true,
    "eval_before_promotion": true,
    "rollback_required": true,
    "adapters_allowed": true,
    "preferred_deployment": "ONE_NOX_PERSONA; INTERNAL_ADAPTER_ROUTING_HIDDEN"
  },
  "resources": {
    "a100": "PRIORITIZE_EXISTING_NOX_TRAINER; NEVER_START_5_TEACHERS_ON_SAME_BUSY_GPU",
    "vm_a4000": "RUN_SMALL_GGUF_TEACHERS, BANDWIDTH_AND_VRAM_GATED",
    "cpu_ram": "USEFUL_PREPROCESSING_AND_CACHING_NOT_FAKE_LOAD",
    "output": "S03_PROVENANCE_AND_CHECKPOINTS_ONLY_AFTER_REAL_VERIFICATION",
    "a40_current_observed": {
      "pod": "saep5w24i02tl0",
      "location": "EU-SE-1 Sweden",
      "gpu_util_pct": 94,
      "gpu_memory_util_pct": 98,
      "OOM_warning_in_system_logs": true,
      "training_progress": "UNKNOWN",
      "policy": "NO_EXTRA_TEACHERS_OR_GPU_JOBS_UNTIL_MEMORY_OOM_TRIAGED; NO_AUTO_RESTART"
    }
  },
  "states": [
    "CANDIDATE",
    "QUEUED",
    "TEACHER_MEASURED",
    "NOX_ANSWER",
    "EVAL_PENDING",
    "ACCEPTED_FOR_TRAINING",
    "OPTIMIZER_UPDATED",
    "EVAL_PASS",
    "PROMOTED_OR_ROLLBACK"
  ],
  "efficiency_policy": {
    "version": "NOX_WOW_EFFICIENCY_V3",
    "status": "PROPOSAL_NOT_RUNTIME_DEPLOYED",
    "objective": "Maximize verified student ability per GPU-hour and user-perceived responsiveness; not model count, token volume, utilization or activity.",
    "user_chat": {
      "always_student_first": true,
      "default_teacher_fanout": 0,
      "external_teacher_wait_ms": 0,
      "automatic_teacher_polling_per_chat": false,
      "verified_s03_recall_only": true,
      "reflect_only_on_task_failure_or_high_stakes": true,
      "explicit_deep_review_opt_in": true,
      "return_unverified_as_uncertain": true
    },
    "teacher_planning": {
      "selection_by": "missing_skill_on_source_separated_holdout",
      "active_teacher_default": 1,
      "second_teacher_only_if": "complementary_family_or_measured_disagreement_with_expected_quality_gain",
      "max_parallel": "hardware_and_owner_budget_gated",
      "stop_if": "no_incremental_gain_on_distinct_holdout_or_cost_exceeds_benefit",
      "download_only_after": "existing_sha_inventory_and_license_security_checks",
      "never_duplicate_existing_weights": true
    },
    "training": {
      "sample_policy": "approved_nonprivate_examples_only; novelty_and_source_dedup before GPU work",
      "learning_trigger": "verified_skill_gap_and_evaluable_training_corpus",
      "teacher_output_not_proof_of_training": true,
      "receipt": "actual student optimizer steps and immutable checkpoint SHA",
      "evaluation": "blind holdout before/after including latency, RU/ES, reasoning, code tests, memory and safety regressions",
      "promotion": "NO_GAIN => HOLD_OR_ROLLBACK; owner acceptance; never interrupt active trainer",
      "model_identity": "one NOX regardless of internal teacher or training process"
    },
    "memory": {
      "one_S03": true,
      "recall_budget": "topical bounded retrieval then rerank only if ambiguous",
      "provenance": "source, timestamp, confidence, conflict, verified_event",
      "no_history_fabrication": true,
      "cache": "invalidate on S03 changes; not an independent memory store"
    },
    "worms": {
      "run": "existing idle tick only",
      "trigger": "changed_source_or_unmet_skill_gap_or_verified_error",
      "TTL_and_quotas_required": true,
      "stop_fail_closed": true,
      "proposal_only": true,
      "no_self_replication": true,
      "no_auto_install_or_merge": true
    },
    "forge": {
      "patch_then_test_then_accept": true,
      "real_artifact_or_hold": true,
      "no_stub_pass": true,
      "one_patch_one_test_one_save": true
    },
    "metrics": [
      "student_task_success_delta",
      "regression_count",
      "accepted_novel_samples",
      "gpu_hours_per_verified_gain",
      "median_first_token_latency",
      "S03_recall_precision",
      "FORGE_patches_passed_with_real_tests"
    ],
    "anti_metrics": [
      "teacher_count",
      "gpu_utilization_as_intelligence",
      "number_of_worm_processes",
      "unverified_training_percent"
    ]
  }
}
